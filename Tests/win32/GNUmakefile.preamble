# Extra build settings for the win32 display server tests.

# config.h (used by the source-level guards) sits at the top of the (build)
# tree.
ADDITIONAL_INCLUDE_DIRS += -I$(GNUSTEP_BUILD_DIR)/../.. -I../..

-include $(GNUSTEP_BUILD_DIR)/../../config.make
-include ../../config.make

# The pasteboard test talks to gpbs through AppKit's NSPasteboard and puts
# data on the Windows clipboard directly.
ADDITIONAL_TOOL_LIBS += -lgnustep-gui
ifeq ($(BUILD_SERVER),win32)
ADDITIONAL_TOOL_LIBS += -luser32 -lgdi32
endif
